{
  "name": "parquet-editor",
  "displayName": "Parquet Editor",
  "description": "View and edit Apache Parquet files in a spreadsheet-style interface",
  "version": "0.0.4",
  "publisher": "khaym",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/khaym/parquetviewer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "parquetEditor.editor",
        "displayName": "Parquet Editor",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webview": "cd webview && npx vitest run",
    "build:ext": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node && cp node_modules/parquet-wasm/esm/parquet_wasm_bg.wasm dist/",
    "dev:webview": "cd webview && npx vite",
    "build:webview": "cd webview && vite build",
    "build": "npm run build:ext && npm run build:webview",
    "test:e2e": "cd webview && npx playwright test",
    "lint": "tsc --noEmit && tsc --noEmit -p webview",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.5.3",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.3.1",
    "apache-arrow": "^21.1.0",
    "parquet-wasm": "^0.9.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  }
}
